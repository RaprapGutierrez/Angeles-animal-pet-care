<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <!-- ── Favicons ── -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="shortcut icon" href="/favicon-32x32.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1e3a8a" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Animal Care Hospital</title>

    <style>
      #splash {
        position: fixed; inset: 0;
        background: #f0f3fa;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        z-index: 9999; transition: opacity 0.5s ease;
      }

      /* Hospital profile photo (existing) */
      #splash .hospital-img {
        width: 100px; height: 100px;
        border-radius: 50%; border: 4px solid #e8edf8;
        object-fit: cover; margin-bottom: 20px;
        animation: pulse 1.5s ease-in-out infinite;
      }

      #splash h1 { font-family: sans-serif; font-size: 22px; font-weight: 800; color: #1a1a6e; margin: 0 0 6px; }
      #splash p.sub  { font-family: sans-serif; font-size: 13px; color: #64748b; margin: 0 0 28px; }

      .spinner { width: 36px; height: 36px; border: 3px solid #e8edf8; border-top-color: #1e3a8a; border-radius: 50%; animation: spin 0.8s linear infinite; }

      /* ── SeraphVet badge ── */
      .seraphvet-badge {
        position: absolute;
        bottom: 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
      }
      .seraphvet-badge img {
        width: 90px; height: 90px;
        object-fit: contain;
        opacity: 0.85;
      }
      .seraphvet-badge span {
        font-family: sans-serif;
        font-size: 11px;
        color: #94a3b8;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .seraphvet-badge strong {
        color: #1a1a6e;
        font-weight: 700;
      }

      @keyframes spin  { to { transform: rotate(360deg); } }
      @keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    </style>
  </head>
  <body>
    <div id="splash">
      <!-- Existing hospital profile image -->
      <img class="hospital-img" src="/image/446805041_881106557364617_1125518808684788316_n.jpg" alt="Logo" />
      <h1>Animal Care Hospital</h1>
      <p class="sub">Management System</p>
      <div class="spinner"></div>

      <!-- SeraphVet branding badge -->
      <div class="seraphvet-badge">
        <img src="/image/seraphvet-logo.png" alt="SeraphVet Logo" />
        <span>Made with <strong>SeraphVet</strong></span>
      </div>
    </div>

    <div id="root"></div>

    <script>
      setTimeout(() => {
        const splash = document.getElementById('splash');
        if (splash) { splash.style.opacity = '0'; setTimeout(() => splash.remove(), 500); }
      }, 2500);
    </script>

    <script type="module" src="/src/main.jsx"></script>
  </body>
</html>